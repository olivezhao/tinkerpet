{
  "manifest_version": 3,
  "name": "TinkerPet Companion",
  "version": "0.2.0",
  "description": "Connect ChatGPT, Claude, Gemini, and DeepSeek waiting states to your TinkerPet desktop pet.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:17321/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["src/content/contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "action": {
    "default_title": "TinkerPet"
  }
}
